// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Stores verified users and their Roblox linkage
model User {
  id                 String              @id @default(cuid())
  discordId          String              @unique
  robloxId           String              @unique
  robloxUsername     String
  verifiedAt         DateTime            @default(now())
  points             Int                 @default(0)
  lastDecayDate      DateTime?           // Last time decay was applied
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  // Relations
  pointTransactions  PointTransaction[]
  activityLogs       ActivityLog[]
  promotionHistory   PromotionHistory[]
  activitySessions   ActivitySession[]
  playtimeSessions   PlaytimeSession[]

  @@index([discordId])
  @@index([robloxId])
}

// Tracks all point transactions (given/removed)
model PointTransaction {
  id                  String   @id @default(cuid())
  userId              String
  amount              Int
  reason              String
  givenByDiscordId    String?
  givenByRobloxId     String?
  givenByUsername     String?
  type                String   // "add" or "remove"
  source              String   // "discord" or "api" or "activity"
  createdAt           DateTime @default(now())

  // Relations
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

// Stores server-specific configuration
model GuildConfig {
  id                  String    @id @default(cuid())
  guildId             String    @unique
  primaryGroupId      String?
  verifiedRoleId      String?
  unverifiedRoleId    String?
  logChannelId        String?
  officerRank         Int?
  adminRoleId         String?
  apiKey              String?
  nicknameFormat      String?   // e.g., "[{rank}] {username}"
  robloxCookie        String?   // Encrypted .ROBLOSECURITY cookie
  promotionMode       String?   @default("auto") // "auto" or "request"
  promotionsChannelId String?   // Channel for promotion requests
  pointsCooldown      Int?      @default(0) // Cooldown in seconds
  maxPointsPerGive    Int?      // Max points that can be given at once
  dailyPointsLimit    Int?      // Max points an officer can give per day
  pointDecayPerWeek   Int?      @default(0) // Points that decay weekly

  // Stats Channels
  statsEnabled        Boolean   @default(false)
  statsCategory       String?
  statsMembersChannel String?
  statsVerifiedChannel String?
  statsInGameChannel  String?
  statsPointsChannel  String?
  statsBansChannel    String?

  // Welcome/Goodbye System
  welcomeChannelId    String?
  welcomeMessage      String?
  welcomeDmEnabled    Boolean   @default(false)
  welcomeDmMessage    String?
  goodbyeChannelId    String?
  goodbyeMessage      String?

  // Auto-role on join
  autoRoleId          String?

  // Suggestion System
  suggestionsChannelId String?

  // Ticket System
  ticketCategoryId    String?
  ticketLogChannelId  String?
  ticketPingRoleId    String?

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relations
  roleBindings        RoleBinding[]
  groupBindings       GroupBinding[]
  activityConfigs     ActivityConfig[]
  pointThresholds     PointThreshold[]
  promotionRanks      PromotionRank[]
  protectedRanks      ProtectedRank[]
  decayImmunity       DecayImmunityRank[]

  @@index([guildId])
}

// Binds Roblox group ranks to Discord roles
model RoleBinding {
  id              String      @id @default(cuid())
  guildId         String
  discordRoleId   String
  groupId         String
  minRank         Int?
  maxRank         Int?
  exactRank       Int?
  rankName        String?
  createdAt       DateTime    @default(now())

  // Relations
  guildConfig     GuildConfig @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@index([guildId])
}

// Binds Roblox groups (membership) to Discord roles
model GroupBinding {
  id              String      @id @default(cuid())
  guildId         String
  groupId         String
  discordRoleId   String
  createdAt       DateTime    @default(now())

  // Relations
  guildConfig     GuildConfig @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@index([guildId])
}

// Configures automatic points for activities
model ActivityConfig {
  id              String      @id @default(cuid())
  guildId         String
  activityType    String      // e.g., "playtime", "training", "event"
  pointsPerUnit   Float       // e.g., 1 point per minute
  createdAt       DateTime    @default(now())

  // Relations
  guildConfig     GuildConfig @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@unique([guildId, activityType])
  @@index([guildId])
}

// Logs activity from Roblox games
model ActivityLog {
  id              String   @id @default(cuid())
  userId          String
  activityType    String
  value           Float    // e.g., minutes played, number of events
  metadata        String?  // JSON string for additional data
  createdAt       DateTime @default(now())

  // Relations
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([activityType])
  @@index([createdAt])
}

// Stores point thresholds for notifications
model PointThreshold {
  id              String      @id @default(cuid())
  guildId         String
  pointsRequired  Int
  message         String
  createdAt       DateTime    @default(now())

  // Relations
  guildConfig     GuildConfig @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@index([guildId])
}

// Stores verification codes
model VerificationCode {
  id              String   @id @default(cuid())
  discordId       String   @unique
  code            String   @unique
  createdAt       DateTime @default(now())
  expiresAt       DateTime

  @@index([discordId])
  @@index([code])
}

// Auto-promotion ranks based on points
model PromotionRank {
  id              String      @id @default(cuid())
  guildId         String
  pointsRequired  Int
  robloxRankId    Int         // The rank number (1-255) in Roblox group
  rankName        String
  createdAt       DateTime    @default(now())

  // Relations
  guildConfig     GuildConfig @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@unique([guildId, pointsRequired])
  @@index([guildId])
  @@index([pointsRequired])
}

// Tracks promotion history
model PromotionHistory {
  id              String   @id @default(cuid())
  userId          String
  guildId         String
  fromRank        Int?     // Previous rank (null if first promotion)
  toRank          Int      // New rank
  rankName        String   // Name of the new rank
  reason          String   // e.g., "Auto-promoted for reaching 100 points"
  promotedBy      String?  // Discord ID who manually promoted (null for auto)
  createdAt       DateTime @default(now())

  // Relations
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([guildId])
  @@index([createdAt])
}

// Protected ranks that bot cannot change
model ProtectedRank {
  id              String      @id @default(cuid())
  guildId         String
  rankId          Int         // Roblox rank number
  rankName        String?
  createdAt       DateTime    @default(now())

  // Relations
  guildConfig     GuildConfig @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@unique([guildId, rankId])
  @@index([guildId])
}

// Ranks immune to point decay
model DecayImmunityRank {
  id              String      @id @default(cuid())
  guildId         String
  rankId          Int
  rankName        String?
  createdAt       DateTime    @default(now())

  // Relations
  guildConfig     GuildConfig @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@unique([guildId, rankId])
  @@index([guildId])
}

// Cooldowns for giving points
model PointCooldown {
  id              String   @id @default(cuid())
  guildId         String
  officerId       String   // Discord ID of officer
  targetId        String   // Discord ID of user who received points
  lastGiven       DateTime
  createdAt       DateTime @default(now())

  @@unique([guildId, officerId, targetId])
  @@index([guildId])
  @@index([officerId])
  @@index([lastGiven])
}

// Daily points tracking for officers
model DailyPointsGiven {
  id              String   @id @default(cuid())
  guildId         String
  officerId       String   // Discord ID
  date            DateTime // Date (should be start of day)
  totalGiven      Int      @default(0)
  createdAt       DateTime @default(now())

  @@unique([guildId, officerId, date])
  @@index([guildId])
  @@index([officerId])
  @@index([date])
}

// Active game sessions for playtime tracking
model ActivitySession {
  id              String    @id @default(cuid())
  userId          String
  guildId         String
  sessionType     String    // "playtime", "patrol", etc.
  startTime       DateTime
  endTime         DateTime?
  pointsAwarded   Int?
  createdAt       DateTime  @default(now())

  // Relations
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([guildId])
  @@index([sessionType])
}

// Playtime sessions from Roblox game (works for verified AND unverified users)
model PlaytimeSession {
  id              Int       @id @default(autoincrement())
  robloxId        String    // Store as string to match User.robloxId
  userId          String?   // Link to User if verified (nullable)
  date            DateTime  @db.Date // For grouping by day
  duration        Int       // Duration in seconds
  metadata        Json?     // Store extra data from game
  createdAt       DateTime  @default(now())

  // Relations (optional, only if verified)
  user            User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([robloxId, date])
  @@index([robloxId])
  @@index([date])
  @@index([userId])
}

// Audit log for all actions
model AuditLog {
  id              String   @id @default(cuid())
  guildId         String
  action          String   // "points_given", "promoted", "demoted", "rank_set", etc.
  executorId      String   // Discord ID who performed the action
  targetId        String?  // Discord ID or Roblox ID of target
  details         String   // JSON string with action details
  createdAt       DateTime @default(now())

  @@index([guildId])
  @@index([executorId])
  @@index([targetId])
  @@index([createdAt])
  @@index([action])
}

// ==================== MODERATION SYSTEM ====================

// Bans (Discord + Roblox game)
model Ban {
  id                    Int       @id @default(autoincrement())
  guildId               String    // Discord server ID

  // Target info
  robloxId              String?   // Roblox user ID (if known)
  robloxUsername        String?   // Roblox username at time of ban
  discordId             String?   // Discord user ID (if known)
  discordUsername       String?   // Discord username at time of ban

  // Ban details
  reason                String    // Why they were banned
  evidence              String?   // Optional evidence (image URLs, descriptions)
  duration              Int?      // Duration in seconds (NULL = permanent)
  expiresAt             DateTime? // When the ban expires (NULL = permanent)

  // Status
  active                Boolean   @default(true)
  unbannedAt            DateTime?
  unbannedBy            String?   // Discord ID of who unbanned
  unbanReason           String?

  // Moderator info
  moderatorDiscordId    String
  moderatorUsername     String

  // Tracking
  bannedInDiscord       Boolean   @default(false) // Was the Discord ban successful?
  bannedInRoblox        Boolean   @default(false) // Was the Roblox game ban successful?

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([guildId, robloxId])
  @@index([guildId, discordId])
  @@index([guildId, active])
  @@index([expiresAt])
}

// Warnings issued to users
model Warning {
  id                  Int       @id @default(autoincrement())
  guildId             String

  // Target
  robloxId            String?
  discordId           String?
  targetUsername      String    // Username at time of warning

  // Warning details
  reason              String
  severity            String    @default("low") // "low", "medium", "high"

  // Moderator
  moderatorDiscordId  String
  moderatorUsername   String

  // Status
  active              Boolean   @default(true)  // Can be pardoned
  pardonedAt          DateTime?
  pardonedBy          String?

  createdAt           DateTime  @default(now())

  @@index([guildId, discordId])
  @@index([guildId, robloxId])
  @@index([guildId, active])
}

// Kicks from Discord + Roblox
model Kick {
  id                  Int       @id @default(autoincrement())
  guildId             String

  robloxId            String?
  discordId           String?
  targetUsername      String

  reason              String

  kickedFromDiscord   Boolean   @default(false)
  kickedFromRoblox    Boolean   @default(false)

  moderatorDiscordId  String
  moderatorUsername   String

  createdAt           DateTime  @default(now())

  @@index([guildId, discordId])
  @@index([guildId, robloxId])
}

// Pending kicks for Roblox game to process
model PendingKick {
  id              Int       @id @default(autoincrement())
  robloxId        String
  reason          String
  delivered       Boolean   @default(false)
  confirmed       Boolean   @default(false)
  createdAt       DateTime  @default(now())

  @@index([robloxId, delivered])
}

// Moderation configuration per server
model ModerationConfig {
  id                    String    @id // guildId

  // Channels
  modLogChannelId       String?   // Where mod actions are logged
  banAppealChannelId    String?   // Where ban appeals go

  // Auto-moderation
  autoKickWarnings      Int?      // Auto-kick after X warnings (null = disabled)
  autoBanWarnings       Int?      // Auto-ban after X warnings (null = disabled)

  // Roblox game ban integration
  gameBanEnabled        Boolean   @default(true)  // Sync bans to Roblox game

  // Roles
  moderatorRoleId       String?   // Who can use moderation commands

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

// ==================== FEATURE SYSTEMS ====================

// Suggestions from users
model Suggestion {
  id              Int       @id @default(autoincrement())
  guildId         String
  authorDiscordId String
  authorUsername  String
  content         String
  status          String    @default("pending") // "pending", "approved", "denied"
  statusReason    String?
  statusBy        String?   // Discord ID of reviewer
  messageId       String?   // Discord message ID for editing
  threadId        String?   // Discussion thread ID
  upvotes         Int       @default(0)
  downvotes       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([guildId, status])
}

// Support tickets
model Ticket {
  id              Int       @id @default(autoincrement())
  guildId         String
  channelId       String    @unique
  authorDiscordId String
  authorUsername  String
  claimedBy       String?   // Moderator Discord ID
  status          String    @default("open") // "open", "claimed", "closed"
  closedBy        String?
  closeReason     String?
  transcriptUrl   String?
  createdAt       DateTime  @default(now())
  closedAt        DateTime?

  @@index([guildId, status])
}

// Giveaways
model Giveaway {
  id              Int       @id @default(autoincrement())
  guildId         String
  channelId       String
  messageId       String
  prize           String
  winnersCount    Int       @default(1)
  hostDiscordId   String
  endsAt          DateTime
  ended           Boolean   @default(false)
  winners         String[]  // Array of Discord user IDs
  createdAt       DateTime  @default(now())

  @@index([guildId, ended])
  @@index([endsAt])
}
