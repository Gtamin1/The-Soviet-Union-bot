# ====================================
# DISCORD BOT CONFIGURATION
# ====================================

# Discord Bot Token (from Discord Developer Portal)
# Go to: https://discord.com/developers/applications
# Select your app → Bot → Reset Token
DISCORD_TOKEN=your_discord_bot_token_here

# Discord Application ID (from Discord Developer Portal)
# Go to: https://discord.com/developers/applications
# Select your app → General Information → Application ID
DISCORD_CLIENT_ID=your_discord_application_id_here

# ====================================
# DATABASE CONFIGURATION
# ====================================

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Default database name: tsubot
# Default user: tsubot
DATABASE_URL=postgresql://tsubot:your_secure_password_here@localhost:5432/tsubot

# ====================================
# ROBLOX CONFIGURATION
# ====================================

# Roblox .ROBLOSECURITY Cookie
# WARNING: Keep this secret! It provides full access to the Roblox account
# To get: Log into Roblox.com → F12 → Application → Cookies → .ROBLOSECURITY
ROBLOX_COOKIE=_|WARNING:-DO-NOT-SHARE-THIS.--Sharing-this-will-allow-someone-to-log-in-as-you-and-to-steal-your-ROBUX-and-items.|_YOUR_COOKIE_VALUE_HERE

# Your Roblox Group ID
# Find in group URL: https://www.roblox.com/groups/GROUP_ID/Group-Name
ROBLOX_GROUP_ID=your_roblox_group_id_here

# ====================================
# API CONFIGURATION
# ====================================

# Port for Express API server (default: 3000)
API_PORT=3000

# API Key for authenticating requests from Roblox game
# Generate a secure random key: openssl rand -hex 32
# This key is used in BanChecker.lua and other Roblox scripts
API_KEY=generate_a_random_32_character_string_here

# ====================================
# ENVIRONMENT
# ====================================

# Application environment (development or production)
NODE_ENV=production

# Encryption Key (MUST be exactly 32 characters)
# Use: node -e "console.log(require('crypto').randomBytes(32).toString('base64').slice(0, 32))"
ENCRYPTION_KEY=CHANGE_THIS_TO_32_CHARACTERS!!
